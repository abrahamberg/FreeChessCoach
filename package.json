{
  "name": "freechesscoach",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "docker compose up -d --build postgres engine migrate api worker web-dev",
    "dev:down": "docker compose down",
    "build:images": "scripts/build-images.sh",
    "build-eval": "npm run build-lichess-eval-index -w @freechesscoach/api --",
    "find-eval": "npm run find-lichess-eval-fen -w @freechesscoach/api --",
    "build-puzzle-fixture": "npm run build-puzzle-fixture -w @freechesscoach/chess-analysis --",
    "build-puzzle-pool": "npm run build-puzzle-pool -w @freechesscoach/api --",
    "select-puzzles": "npm run select-puzzles -w @freechesscoach/api --",
    "docs:prompts": "npm run docs:prompts -w @freechesscoach/prompts",
    "fetch-and-build-eval": "apps/api/scripts/fetch-and-build-lichess-eval-index.sh",
    "deploy-eval": "apps/api/scripts/deploy-lichess-eval-index.sh",
    "deploy-puzzle-pool": "apps/api/scripts/deploy-puzzle-pool.sh",
    "test": "npm run test --workspaces --if-present",
    "test:changed": "tsx scripts/test-changed.ts",
    "test:corpus": "npm run test:corpus -w @freechesscoach/chess-analysis",
    "typecheck": "tsc -b",
    "typecheck:changed": "tsx scripts/typecheck-changed.ts",
    "lint": "npm run lint --workspaces --if-present",
    "lint:changed": "tsx scripts/lint-changed.ts",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "verify:changed": "npm run lint:changed && npm run typecheck:changed && npm run test:changed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
