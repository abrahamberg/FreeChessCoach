# Runtime image for the engine service: the pre-built bundle plus Stockfish.
#
# Base: Docker Hardened Images (dhi.io, needs `docker login dhi.io`). The runtime
# variant has no shell, no apt and no npm, so everything that installs runs in the
# `-dev` variant of the same image and only the results are copied across. Doing
# `apt-get install stockfish` in the runtime stage cannot work (no apt there).
# Both stages pinned by digest; Dependabot bumps them (.github/dependabot.yml).
FROM dhi.io/node:24-debian13-dev@sha256:b240a2ea0a4e7d9086a3bc1a37f456e0ecd7af9137d8f6c86186d49a27e473d7 AS build

# Debian's stockfish is one self-contained binary (NNUE nets embedded) linked
# only against libstdc++, libgcc_s, libm and libc, all of which the runtime
# image already ships for node itself.
RUN apt-get update \
    && apt-get install -y --no-install-recommends stockfish \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Install only runtime dependencies inside the target-architecture build. This
# ensures optional/native packages, if added later, resolve for amd64 or arm64
# instead of copying a host-architecture node_modules tree.
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/chess-analysis/package.json packages/chess-analysis/
COPY services/engine/package.json services/engine/
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    --workspace=@freechesscoach/shared \
    --workspace=@freechesscoach/chess-analysis \
    --workspace=@freechesscoach/engine \
    --include-workspace-root

FROM dhi.io/node:24-debian13@sha256:a31a0da71f5b2621589e632098523927419b9bf49bb5d1bda20683f417586615 AS runtime
LABEL org.opencontainers.image.source="https://github.com/abrahamberg/FreeChessCoach"
WORKDIR /app
ENV NODE_ENV=production
ENV STOCKFISH_PATH=/usr/games/stockfish

COPY --from=build /usr/games/stockfish /usr/games/stockfish
COPY --from=build /app/node_modules ./node_modules
# The application bundle is created by scripts/build-images.sh on the runner.
COPY services/engine/dist-bundle ./dist-bundle

# Numeric for the same kubelet reason as Dockerfile.api. Nothing is written at
# runtime (Stockfish keeps its hash table in memory), so the chart runs this with
# readOnlyRootFilesystem.
USER 1000
ENV PORT=8081
EXPOSE 8081
ENTRYPOINT []
CMD ["node", "dist-bundle/server.mjs"]
