# Runtime image for the SPA: nginx serving the pre-built Vite bundle. There is no
# server-side rendering and no `/api` proxying here — in k8s that route belongs to
# oauth2-proxy (architecture §11), not to nginx.
#
# COPY-only by design — `apps/web/dist` is produced on the CI runner by
# `npm run build --workspace=@freechesscoach/web` before this build runs. See
# docs/deploy-build.md.
#
# Static HTML/JS/CSS is architecture-independent by construction: nothing in the
# image is ever executed by Node, so an amd64 runner's output runs unchanged on
# arm64.
#
# Base: Docker Hardened Images (dhi.io, needs `docker login dhi.io`): no shell, no
# package manager, listens on 8080. Pinned by digest; Dependabot bumps it.
FROM dhi.io/nginx:1.29@sha256:d457a278247531873df03b7fdaabd96de0b530624f8e72c73d41e6b81c4487dd AS runtime
LABEL org.opencontainers.image.source="https://github.com/abrahamberg/FreeChessCoach"
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx.security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY apps/web/dist /usr/share/nginx/html

# The base image's user is the *named* `nginx` (65532), which kubelet cannot
# verify for runAsNonRoot (see Dockerfile.api). 1000 keeps every image in this
# repo on the same uid as podSecurityContext.runAsUser in
# deploy/helm/freechesscoach/values.yaml, so `docker run` and a chart-deployed pod
# behave identically. Safe here: docker/nginx.conf puts the pid file and every
# *_temp_path under /tmp, and the served files are world-readable.
USER 1000

EXPOSE 8080
# `-e stderr`: nginx opens its compiled-in error log (/var/log/nginx) before it
# reads nginx.conf, which fails on a read-only root filesystem.
ENTRYPOINT ["nginx", "-e", "stderr"]
CMD ["-g", "daemon off;"]
