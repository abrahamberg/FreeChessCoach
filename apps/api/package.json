{
  "name": "@freechesscoach/api",
  "version": "0.0.1",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "types": "./src/app.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "bundle": "node scripts/bundle.mjs",
    "build-lichess-eval-index": "tsx scripts/build-lichess-eval-index.mjs",
    "find-lichess-eval-fen": "tsx scripts/find-lichess-eval-fen.mjs",
    "build-puzzle-pool": "tsx scripts/build-puzzle-pool.mjs",
    "select-puzzles": "tsx scripts/select-puzzles.mjs",
    "bench:analysis": "tsx scripts/bench-analysis.ts",
    "course:golden": "tsx scripts/course-golden.ts",
    "course:studio": "tsx scripts/course-studio/cli.ts",
    "review:audit": "tsx scripts/review-audit/cli.ts",
    "golden:record": "tsx scripts/course-golden.ts --facts --record-evals",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "test": "vitest run --reporter=../../fail-only-reporter.ts",
    "test:slow": "RUN_SLOW_TESTS=true vitest run slow",
    "test:unit": "vitest run --project unit --reporter=../../fail-only-reporter.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/provider": "^4.0.26",
    "@fastify/websocket": "^11.3.4",
    "@freechesscoach/chess-analysis": "0.0.1",
    "@freechesscoach/prompts": "0.0.1",
    "@freechesscoach/shared": "0.0.1",
    "ai": "^7.0.137",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "graphile-worker": "^0.18.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "ws": "^8.22.0"
  }
}
